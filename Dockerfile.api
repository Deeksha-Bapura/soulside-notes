# Custom base image for the API service — a slim Node image rather than
# the full default, since we don't need build tools, only a runtime.
# Node 22 LTS: Node 20 reached end of life in April 2026.
FROM node:22-alpine AS base

WORKDIR /app

# Copy only the dependency manifests first. Docker caches each instruction
# as a layer; as long as package.json/package-lock.json don't change,
# this layer (and the expensive npm install below) gets reused on
# subsequent builds instead of re-running every time source code changes.
COPY package.json package-lock.json ./

# Install ALL dependencies (not --production), since tsx and TypeScript
# itself are devDependencies but are needed at runtime to actually run
# the server, which is written in TypeScript with no separate build step.
RUN npm ci

# Now copy the actual source code — this layer changes often, but since
# it comes AFTER the install step, editing source files never invalidates
# the cached npm install layer above.
COPY server ./server
COPY src ./src
COPY tsconfig.server.json ./

# Document which port this container listens on. This doesn't actually
# publish the port — that's a docker-compose/docker run concern — it's
# metadata for anyone reading or inspecting this image.
EXPOSE 3001

# Liveness check: is the process up and responding? Uses /healthz, which
# skips the simulated latency/5% failure middleware, so a healthy container
# never gets marked unhealthy by a coin flip. (Kubernetes uses its own
# probes and ignores this; it's for plain Docker/Compose.)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/healthz', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

# Run as the image's built-in unprivileged "node" user (uid 1000) instead of
# root. Kubernetes enforces this with runAsNonRoot in the Helm chart.
USER node

# Run node directly (with tsx as a loader) rather than through npx, so node
# is PID 1 and receives SIGTERM itself. That lets the graceful-shutdown
# handler in server/index.ts run when Kubernetes stops the pod.
CMD ["node", "--import", "tsx", "server/index.ts"]
